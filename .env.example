# Quotes API base URL — Vite inlines VITE_-prefixed vars at build time.
VITE_API_URL=http://localhost:3001/api

# API session token — DO NOT commit a real value.
# Note: Vite inlines this into the JS bundle, so don't treat it as a
# secret in production. Use a backend proxy instead.
VITE_API_TOKEN=dev-token-change-me
